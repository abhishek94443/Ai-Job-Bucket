# Primary Database Connection (Neon PostgreSQL / Cloud Hosted)
# Prioritized over split DB_* variables when present.
# SSL mode (sslmode=require) is preserved directly from the connection string.
DATABASE_URL=postgresql://user:password@ep-example-project.region.aws.neon.tech/neondb?sslmode=require

# Fallback Database Configuration (Local PostgreSQL)
# Used only when DATABASE_URL is not provided or empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_bucket
DB_USER=postgres
DB_PASSWORD=your_password_here
# DB_SSLMODE=prefer

# Openings MCP Path (Optional Override - defaults to system PATH or local binary)
OPENINGS_MCP_PATH=openings-mcp

GEMINI_API_KEY=your_gemini_api_key_here
